{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2022"],
    "rootDir": ".", "strict": true, "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
